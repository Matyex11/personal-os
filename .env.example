# Personal OS — env placeholders only. Copy to .env.local and fill locally.
# NEVER commit real values. NEVER reuse XNINE credentials.
# Phase 1A: local app only — leave Supabase values unset until Phase 1B.
# Phase 1B+: use the dedicated EU DEVELOPMENT Supabase project only.

# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Supabase DEV (Phase 1B — do not connect until the human names the project)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key
# Server/MCP host process only — NEVER expose to agents, browser, or tool results
# SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

# Supabase PROD (later; keep commented until L3)
# PROD_SUPABASE_URL=
# PROD_SUPABASE_ANON_KEY=
# PROD_SUPABASE_SERVICE_ROLE_KEY=

# MCP server (in-repo package; host vendor deferred; Phase 4+)
# MCP_HOST_URL=
# MCP_SHARED_SECRET=
