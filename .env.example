# Personal OS — placeholders only. Copy to .env.local and fill locally.
# NEVER commit real values. NEVER reuse XNINE credentials.
# Phase 1B+: dedicated EU DEVELOPMENT project personal-os-dev only.

# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Supabase DEV (personal-os-dev / eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server/MCP host only later — NEVER expose to agents, browser, or tool results
# SUPABASE_SERVICE_ROLE_KEY=

# MCP server (Phase 4+)
# MCP_HOST_URL=
# MCP_SHARED_SECRET=

# Playwright authenticated e2e (local shell only — never commit real values)
# Dedicated personal-os-dev test user that already has a password set in Settings.
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
